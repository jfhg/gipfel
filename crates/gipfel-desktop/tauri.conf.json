{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gipfel",
  "mainBinaryName": "gipfel",
  "identifier": "org.flpsed.gipfel",
  "build": {
    "frontendDist": "dist",
    "beforeBuildCommand": "sh build-frontend.sh"
  },
  "app": {
    "windows": [
      {
        "title": "gipfel — Photogrammetry for Mountain Images",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Mountain photo peak identification (photogrammetry)",
    "longDescription": "gipfel: open a mountain photo, identify peaks, fit the camera projection and save annotated images. All processing is local; images never leave the machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
